<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Спринт 41: импорт и экспорт видео продолжаются, когда приложение свёрнуто (служба с уведомлением) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Спринт 56: экспорт не замирает при выключенном экране (частичная блокировка сна только на время работы) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="VibeToon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Спринт 59: сборка не debuggable (быстрее), но профилируется: Android Studio Profiler и Perfetto видят процесс -->
        <profileable android:shell="true" tools:targetApi="29" />
        <!-- Спринт 56: singleTask - уведомление и значок возвращают то же окно (а не второй экземпляр с экраном
             проектов); configChanges - смена размера окна, темы, клавиатуры не пересоздаёт экран и не обрывает экспорт -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".work.BackgroundWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
